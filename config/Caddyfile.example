{
    email {$ACME_EMAIL}
    on_demand_tls {
        ask http://127.0.0.1:8000/domain-authorization
    }
}

https:// {
    tls {
        on_demand
    }

    @api path /api/*
    handle @api {
        reverse_proxy 127.0.0.1:8000
    }

    handle {
        root * {$TENALI_WEB_ROOT}
        @asset {
            file {path}
            not path / /index.html
        }
        handle @asset {
            file_server
        }
        handle {
            rewrite * /seo/pages{path}
            reverse_proxy 127.0.0.1:8000
        }
    }
}