TENALI_ENV=production
TENALI_BASE_DOMAIN=your-platform-domain.com
TENALI_DOMAIN_TARGET=app.your-platform-domain.com
CORS_ORIGINS=https://app.your-platform-domain.com
# Generate a Fernet key privately and inject it from your secret manager.
# Required to save/use encrypted per-workspace checkout credentials.
TENALI_CREDENTIAL_KEY=

# Reverse-proxy environment (not browser settings)
ACME_EMAIL=operations@example.com
TENALI_WEB_ROOT=/srv/tenali/web/dist